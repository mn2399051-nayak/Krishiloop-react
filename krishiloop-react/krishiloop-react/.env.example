# ==============================================================================
# KrishiLoop Supabase Configuration
# ==============================================================================
# 1. Create a project at https://supabase.com
# 2. In Project Settings -> API, copy Project URL and anon public key.
# 3. Create a local .env or .env.local file with your real credentials:
#    cp .env.example .env.local
#
# NOTE: When these variables are empty or missing, KrishiLoop automatically
# runs in resilient demo/local mode using pre-configured sample datasets so the
# UI is always fully interactive.
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (safe for frontend client usage with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
