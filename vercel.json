{
  "buildCommand": "cd krishiloop-react/krishiloop-react && npm install && npm run build",
  "outputDirectory": "krishiloop-react/krishiloop-react/dist",
  "rewrites": [
    { "source": "/krishiloop-dashboard.html", "destination": "/krishiloop-dashboard.html" },
    { "source": "/dashboard.html", "destination": "/dashboard.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
